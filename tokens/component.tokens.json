    "fillHalf": {
      "$type": "dimension",
      "$value": "{progressMetric.fillHalf}",
      "$description": "50% の塗り幅。"
    },
    "fillFull": {
      "$type": "dimension",
      "$value": "{progressMetric.fillFull}",
      "$description": "100% の塗り幅。"
    },
    "trackColor": {
      "$type": "color",
      "$value": "{control.progressTrack}",
      "$description": "溝。"
    },
    "fillColor": {
      "$type": "color",
      "$value": "{control.progressFill}",
      "$description": "塗り。"
    }
  },
  "stepper": {
    "width": {
      "$type": "dimension",
