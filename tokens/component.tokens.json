{
  "$description": "Component 専用。Semantic を alias するだけの層（docs/04 §1）。**ここは Component 名で切る**（#196 / #202）—— 値の共有は 1 つ下の semantic / primitive でやり、この層では $switch.trackOff と $slider.trackColor を別々に持つ。こうすると『どれを変えると何が動くか』がこの層だけ読めば分かる。",
  "switch": {
    "trackWidth": {
      "$type": "dimension",
      "$value": "{switchMetric.trackWidth}",
      "$description": "溝の幅。"
    },
    "trackHeight": {
      "$type": "dimension",
      "$value": "{switchMetric.trackHeight}",
      "$description": "溝の高さ。**固定** —— capsule の近似が成り立つ前提（README の近似の表）。"
    },
    "trackRadius": {
      "$type": "dimension",
      "$value": "{switchMetric.trackCorner}",
      "$description": "溝の角丸。trackHeight の半分。"
    },
    "thumbSize": {
      "$type": "dimension",
      "$value": "{switchMetric.thumb}",
      "$description": "つまみの一辺。"
    },
    "thumbRadius": {
      "$type": "dimension",
      "$value": "{switchMetric.thumbCorner}",
      "$description": "つまみの角丸。thumbSize の半分。"
    },
    "inset": {
      "$type": "dimension",
      "$value": "{switchMetric.inset}",
      "$description": "溝の内側の余白。"
    },
    "travel": {
      "$type": "dimension",
      "$value": "{switchMetric.travel}",
      "$description": "on のときの詰め物の幅。"
    },
    "rest": {
      "$type": "dimension",
      "$value": "{switchMetric.zeroTravel}",
      "$description": "off のときの詰め物の幅（0）。"
    },
    "trackOn": {
      "$type": "color",
      "$value": "{control.switchTrack.on}",
      "$description": "on の溝。"
    },
    "trackOff": {
      "$type": "color",
      "$value": "{control.switchTrack.off}",
      "$description": "off の溝。"
    },
    "thumbColor": {
      "$type": "color",
      "$value": "{control.switchThumb}",
      "$description": "つまみの面。"
    },
    "thumbShadow": {
      "$type": "shadow",
      "$value": "{control.raisedShadow}",
      "$description": "つまみの影（2 層）。"
    },
    "disabledOpacity": {
      "$type": "number",
      "$value": "{control.switchDisabled}",
      "$description": "disabled の不透明度。"
    }
  },
  "slider": {
    "trackWidth": {
      "$type": "dimension",
      "$value": "{sliderMetric.trackWidth}",
      "$description": "溝の幅。**固定** —— 塗りの幅を pt で置くので、変えると比率が壊れる（README の近似の表）。"
    },
    "trackHeight": {
      "$type": "dimension",
      "$value": "{sliderMetric.trackHeight}",
      "$description": "溝の高さ。"
    },
    "trackRadius": {
      "$type": "dimension",
      "$value": "{sliderMetric.trackCorner}",
      "$description": "溝の角丸。trackHeight の半分。"
    },
    "thumbSize": {
      "$type": "dimension",
      "$value": "{sliderMetric.thumb}",
      "$description": "つまみの一辺。"
    },
    "thumbRadius": {
      "$type": "dimension",
      "$value": "{sliderMetric.thumbCorner}",
      "$description": "つまみの角丸。thumbSize の半分。"
    },
    "fillMin": {
      "$type": "dimension",
      "$value": "{sliderMetric.fillMin}",
      "$description": "min の塗り幅（0）。"
    },
    "fillMid": {
      "$type": "dimension",
      "$value": "{sliderMetric.fillMid}",
      "$description": "mid の塗り幅。"
    },
    "fillMax": {
      "$type": "dimension",
      "$value": "{sliderMetric.fillMax}",
      "$description": "max の塗り幅。"
    },
    "trackColor": {
      "$type": "color",
      "$value": "{control.sliderTrack}",
      "$description": "未塗りの溝。"
    },
    "fillColor": {
      "$type": "color",
      "$value": "{control.sliderFill}",
      "$description": "塗り。"
    },
    "thumbColor": {
      "$type": "color",
      "$value": "{control.sliderThumb}",
      "$description": "つまみの面。"
    },
    "thumbShadow": {
      "$type": "shadow",
      "$value": "{control.raisedShadow}",
      "$description": "つまみの影（2 層）。Switch と同じ。"
    },
    "disabledOpacity": {
      "$type": "number",
      "$value": "{control.switchDisabled}",
      "$description": "disabled の不透明度。"
    }
  },
