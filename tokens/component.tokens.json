    }
  },
  "segmented": {
    "width": {
      "$type": "dimension",
      "$value": "{segmentedMetric.width}",
      "$description": "全体の幅。**固定** —— インジケータの位置を pt で置くので、変えると選択位置がずれる。"
    },
    "height": {
      "$type": "dimension",
      "$value": "{segmentedMetric.height}",
